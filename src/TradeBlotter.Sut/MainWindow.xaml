<Window x:Class="TradeBlotter.Sut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TradeBlotter Desktop — Multi-Asset Trading Desk" Height="500" Width="850"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="TradeBlotterMainView"
        Background="#0F172A" Foreground="#F8FAFC">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Real-time Ticker -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="TRADEBLOTTER" FontSize="20" FontWeight="ExtraBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                <TextBlock Text="PRO" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" Background="#78350F" Padding="4,2" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text=" | Capital Markets Desk" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>

            <!-- Ticker -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="LIVE FEED: " Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtPriceTicker" AutomationProperties.AutomationId="TxtPriceTicker" 
                               Text="EUR/USD 1.0842 ▲ | GBP/USD 1.2715 ▼" Foreground="#4ADE80" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Action Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnNewOrder" AutomationProperties.AutomationId="BtnNewOrder" 
                        Content="+ New Order" Width="110" Height="32" Margin="0,0,10,0"
                        Background="#0284C7" Foreground="White" FontWeight="SemiBold" Click="BtnNewOrder_Click"/>
                <Button x:Name="BtnCancelOrder" AutomationProperties.AutomationId="BtnCancelOrder" 
                        Content="Cancel Selected" Width="120" Height="32" Margin="0,0,10,0"
                        Background="#475569" Foreground="White" Click="BtnCancelOrder_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Active Desk: FX Spot" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border Background="#10B981" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" ToolTip="Connected to Market"/>
            </StackPanel>
        </Grid>

        <!-- Orders DataGrid -->
        <DataGrid Grid.Row="2" x:Name="GridBlotterOrders" 
                  AutomationProperties.AutomationId="GridBlotterOrders"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  Background="#1E293B" RowBackground="#1E293B" AlternatingRowBackground="#0F172A"
                  Foreground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                  BorderBrush="#334155" BorderThickness="1" SelectionMode="Single"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  HeadersVisibility="Column" FontSize="13">
            <DataGrid.Resources>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                </Style>
                <Style TargetType="{x:Type DataGridRow}">
                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding OrderId}"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding OrderId}"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" Width="130"/>
                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="100"/>
                <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="80"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat='{}{0:N0}'}" Width="110"/>
                <DataGridTextColumn Header="Limit Price" Binding="{Binding LimitPrice, StringFormat='{}{0:F4}'}" Width="110"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                <DataGridTextColumn Header="Filled Qty" Binding="{Binding FilledQuantity, StringFormat='{}{0:N0}'}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3" Background="#0F172A" Margin="0,10,0,0" Foreground="#64748B">
            <StatusBarItem>
                <TextBlock x:Name="TxtTotalOrders" Text="Total Orders: 4"/>
            </StatusBarItem>
            <Separator Background="#334155"/>
            <StatusBarItem>
                <TextBlock Text="Mode: Deterministic Mock Feed"/>
            </StatusBarItem>
            <Separator Background="#334155"/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Server Latency: 4ms | Host: Windows 11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
