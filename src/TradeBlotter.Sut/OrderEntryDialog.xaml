<Window x:Class="TradeBlotter.Sut.OrderEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Order Entry" Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="DlgOrderEntry"
        Background="#1E293B" Foreground="#F8FAFC"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Submit New Order" 
                   FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,15"/>

        <!-- Symbol -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Currency Pair:" VerticalAlignment="Center" Margin="0,5"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbSymbol" 
                  AutomationProperties.AutomationId="CmbSymbol" Margin="0,5" SelectedIndex="0">
            <ComboBoxItem Content="EUR/USD"/>
            <ComboBoxItem Content="GBP/USD"/>
            <ComboBoxItem Content="USD/JPY"/>
            <ComboBoxItem Content="USD/CHF"/>
        </ComboBox>

        <!-- Quantity -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Quantity:" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtQuantity" 
                 AutomationProperties.AutomationId="TxtQuantity" Text="100000" Margin="0,5"/>

        <!-- Order Type -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Order Type:" VerticalAlignment="Center" Margin="0,5"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CmbOrderType" 
                  AutomationProperties.AutomationId="CmbOrderType" Margin="0,5" SelectedIndex="0"
                  SelectionChanged="CmbOrderType_SelectionChanged">
            <ComboBoxItem Content="LIMIT"/>
            <ComboBoxItem Content="MARKET"/>
        </ComboBox>

        <!-- Limit Price -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Limit Price:" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtLimitPrice" 
                 AutomationProperties.AutomationId="TxtLimitPrice" Text="1.0850" Margin="0,5"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnCancelModal" AutomationProperties.AutomationId="BtnCancelModal" 
                    Content="Cancel" Width="90" Height="32" Margin="0,0,10,0" Click="BtnCancel_Click"
                    Background="#475569" Foreground="White"/>
            <Button x:Name="BtnSubmitOrder" AutomationProperties.AutomationId="BtnSubmitOrder" 
                    Content="Submit Order" Width="110" Height="32" Click="BtnSubmit_Click"
                    Background="#0284C7" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
